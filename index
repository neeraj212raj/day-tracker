  <!-- ================= UNIVERSAL PASSCODE CLOUD SYNC SCRIPT ================= -->
  <script>
    let deferredInstallPrompt = null;

    // Generate crisp vector/canvas icons and inject PWA manifest dynamically
    (function setupPwaManifest() {
      try {
        function createIconDataUrl(size) {
          const canvas = document.createElement('canvas');
          canvas.width = size;
          canvas.height = size;
          const ctx = canvas.getContext('2d');
          
          // Background gradient
          const grad = ctx.createLinearGradient(0, 0, size, size);
          grad.addColorStop(0, '#4f46e5');
          grad.addColorStop(1, '#7c3aed');
          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.roundRect(0, 0, size, size, size * 0.22);
          ctx.fill();

          // Checkmark symbol
          ctx.strokeStyle = '#ffffff';
          ctx.lineWidth = size * 0.1;
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          ctx.beginPath();
          ctx.moveTo(size * 0.28, size * 0.52);
          ctx.lineTo(size * 0.44, size * 0.68);
          ctx.lineTo(size * 0.74, size * 0.35);
          ctx.stroke();

          return canvas.toDataURL('image/png');
        }

        const icon192 = createIconDataUrl(192);
        const icon512 = createIconDataUrl(512);

        const appleIcon = document.getElementById('apple-touch-icon');
        if (appleIcon) appleIcon.href = icon192;

        const manifestData = {
          name: "DayTrack Pro - Daily Planner",
          short_name: "DayTrack",
          start_url: window.location.href.split('#')[0],
          display: "standalone",
          background_color: "#f8fafc",
          theme_color: "#4f46e5",
          icons: [
            { src: icon192, sizes: "192x192", type: "image/png", purpose: "any maskable" },
            { src: icon512, sizes: "512x512", type: "image/png", purpose: "any maskable" }
          ]
        };

        const blob = new Blob([JSON.stringify(manifestData)], { type: 'application/manifest+json' });
        const manifestUrl = URL.createObjectURL(blob);
        const link = document.createElement('link');
        link.rel = 'manifest';
        link.href = manifestUrl;
        document.head.appendChild(link);
      } catch (e) {
        console.warn('PWA manifest generation note:', e);
      }
    })();

    // Listen for Chrome's native install prompt
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredInstallPrompt = e;
      
      const btnHeader = document.getElementById('btn-install-app');
      const btnModal = document.getElementById('btn-modal-install-app');
      if (btnHeader) {
        btnHeader.classList.remove('hidden');
        btnHeader.classList.add('flex');
      }
      if (btnModal) {
        btnModal.classList.remove('hidden');
        btnModal.classList.add('flex');
      }
    });

    async function triggerPwaInstall() {
      if (!deferredInstallPrompt) return;
      deferredInstallPrompt.prompt();
      const choiceResult = await deferredInstallPrompt.userChoice;
      if (choiceResult.outcome === 'accepted') {
        const btnHeader = document.getElementById('btn-install-app');
        const btnModal = document.getElementById('btn-modal-install-app');
        if (btnHeader) btnHeader.classList.add('hidden');
        if (btnModal) btnModal.classList.add('hidden');
      }
      deferredInstallPrompt = null;
    }

    const DayTracker = (() => {
      // Unique sender ID for this browser tab/device to prevent loopback
      const myClientId = 'client_' + Math.random().toString(36).substring(2, 9);
      let sseConnection = null;
      let lastSyncTimestamp = 0;
      let isBroadcasting = false;
      let initialPullCompleted = false; // Safety lock for cloud overwrite

      // Passcode setup
      let currentPasscode = (localStorage.getItem('DAYTRACK_PASSCODE') || 'MY-PLANNER')
        .trim()
        .toUpperCase()
        .replace(/[^A-Z0-9_-]/g, '-');

      const defaultHabits = [
        { id: 'h1', title: 'Morning Fitness & Mobility', start: '07:00', end: '08:00', priority: 'High', category: 'Health' },
        { id: 'h2', title: 'Inbox & Daily Priority Block', start: '09:00', end: '09:30', priority: 'Medium', category: 'Planning' },
        { id: 'h3', title: 'Deep Work Focus Block 1', start: '10:00', end: '12:00', priority: 'High', category: 'Deep Work' },
        { id: 'h4', title: 'Lunch & Screen Disconnect', start: '13:00', end: '14:00', priority: 'Low', category: 'Personal' },
        { id: 'h5', title: 'Daily Review & Next Day Plan', start: '20:30', end: '21:00', priority: 'High', category: 'Planning' },
      ];

      let state = {
        tasksByDate: {},
        habits: [...defaultHabits],
        history: {}
      };

      let currentDate = getFormattedDate(new Date());
      let currentFilter = 'all';
      let chartInstance = null;
      let chartRange = 'week';

      function getFormattedDate(d) {
        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
      }

      function getTopicName() {
        const cleanCode = currentPasscode.toLowerCase().replace(/[^a-z0-9]/g, '_');
        return `dt_planner_${cleanCode}`;
      }

      function showToast(msg) {
        const toast = document.getElementById('toast');
        const toastMsg = document.getElementById('toast-message');
        if (!toast || !toastMsg) return;
        toastMsg.innerText = msg;
        toast.classList.remove('-translate-y-20', 'sm:translate-y-20', 'opacity-0');
        setTimeout(() => {
          toast.classList.add('-translate-y-20', 'sm:translate-y-20', 'opacity-0');
        }, 2500);
      }

      function updateSyncStatus(status) {
        const statusEl = document.getElementById('cloud-sync-status');
        const pulseDot = document.getElementById('cloud-pulse-dot');
        const badgeText = document.getElementById('passcode-display-badge');
        if (!statusEl || !pulseDot || !badgeText) return;

        badgeText.innerText = `KEY: ${currentPasscode}`;

        if (status === 'syncing') {
          statusEl.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 text-amber-700 border border-amber-200 transition';
          pulseDot.className = 'w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse';
        } else if (status === 'synced') {
          statusEl.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 transition hover:bg-emerald-100 shadow-2xs';
          pulseDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse';
        } else {
          statusEl.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-rose-50 text-rose-700 border border-rose-200 transition hover:bg-rose-100';
          pulseDot.className = 'w-1.5 h-1.5 rounded-full bg-rose-500';
        }
      }

      function loadLocalFallback() {
        try {
          const cTasks = localStorage.getItem(`daytrack_tasks_${currentPasscode}`);
          if (cTasks) state.tasksByDate = JSON.parse(cTasks);

          const cHabits = localStorage.getItem(`daytrack_habits_${currentPasscode}`);
          if (cHabits) state.habits = JSON.parse(cHabits);

          const cHistory = localStorage.getItem(`daytrack_history_${currentPasscode}`);
          if (cHistory) state.history = JSON.parse(cHistory);
        } catch(e) {
          console.warn('Local storage parse error', e);
        }
      }

      function saveLocal() {
        try {
          localStorage.setItem(`daytrack_tasks_${currentPasscode}`, JSON.stringify(state.tasksByDate));
          localStorage.setItem(`daytrack_habits_${currentPasscode}`, JSON.stringify(state.habits));
          localStorage.setItem(`daytrack_history_${currentPasscode}`, JSON.stringify(state.history));
        } catch(e) {}
      }

      // Universal Broadcast over HTTP/CORS
      async function broadcastStateCloud(force = false) {
        // SAFETY LOCK 1: Prevent automatic broadcast if cloud state has not yet been polled
        if (!initialPullCompleted && !force) {
          console.warn('Safety lock: Cloud broadcast deferred until initial sync check completes.');
          return;
        }

        // SAFETY LOCK 2: Never wipe remote data with empty local state unless explicitly forced
        const totalLocalTasks = Object.values(state.tasksByDate).reduce((acc, list) => acc + (list ? list.length : 0), 0);
        if (totalLocalTasks === 0 && !force) {
          console.warn('Safety lock: Prevented broadcasting empty local state over existing cloud data.');
          return;
        }

        saveLocal();
        updateSyncStatus('syncing');

        const topic = getTopicName();
        const payload = {
          senderId: myClientId,
          timestamp: Date.now(),
          passcode: currentPasscode,
          tasksByDate: state.tasksByDate,
          habits: state.habits,
          history: state.history
        };

        try {
          isBroadcasting = true;
          const res = await fetch(`https://ntfy.sh/${topic}`, {
            method: 'POST',
            body: JSON.stringify(payload),
            headers: {
              'Title': 'DayTrackSync',
              'Tags': 'cloud,sync'
            }
          });

          if (res.ok) {
            lastSyncTimestamp = payload.timestamp;
            updateSyncStatus('synced');
          } else {
            updateSyncStatus('synced');
          }
        } catch (err) {
          console.warn('Sync broadcast warning, saved locally:', err);
          updateSyncStatus('synced');
        } finally {
          setTimeout(() => { isBroadcasting = false; }, 400);
        }
      }

      // Pull latest cached state from cloud
      async function pullLatestFromCloud(silent = false) {
        updateSyncStatus('syncing');
        const topic = getTopicName();

        try {
          const res = await fetch(`https://ntfy.sh/${topic}/json?poll=1&since=all`);
          if (!res.ok) throw new Error('Poll failed');

          const text = await res.text();
          const lines = text.trim().split('\n').filter(Boolean);

          let latestRemote = null;
          for (let i = lines.length - 1; i >= 0; i--) {
            try {
              const item = JSON.parse(lines[i]);
              if (item.event === 'message' && item.message) {
                const parsed = JSON.parse(item.message);
                if (parsed && parsed.timestamp && (!latestRemote || parsed.timestamp > latestRemote.timestamp)) {
                  latestRemote = parsed;
                }
              }
            } catch(e) {}
          }

          if (latestRemote && latestRemote.timestamp > lastSyncTimestamp) {
            applyRemoteState(latestRemote);
            if (!silent) showToast('Latest plan pulled from cloud! ☁️');
          } else {
            if (!silent) showToast('Already up to date!');
          }
          updateSyncStatus('synced');
        } catch (err) {
          console.warn('Initial cloud pull note:', err.message);
          updateSyncStatus('synced');
        } finally {
          // Once the first pull resolves (even if it failed), allow broadcasts
          initialPullCompleted = true;
        }
      }

      function applyRemoteState(remote) {
        if (!remote) return;
        lastSyncTimestamp = remote.timestamp;
        
        if (remote.tasksByDate) {
          // Merge dates safely so past days are not erased by partial device caches
          state.tasksByDate = { ...remote.tasksByDate, ...state.tasksByDate };
          Object.keys(remote.tasksByDate).forEach(d => {
            if (!state.tasksByDate[d] || remote.tasksByDate[d].length >= state.tasksByDate[d].length) {
              state.tasksByDate[d] = remote.tasksByDate[d];
            }
          });
        }
        if (remote.habits && remote.habits.length > 0) state.habits = remote.habits;
        if (remote.history) state.history = { ...remote.history, ...state.history };

        saveLocal();
        renderDayTasks();
        renderHabitsBank();
        updateDailyMetrics();

        if (!document.getElementById('view-analytics').classList.contains('hidden')) {
          renderAnalytics();
        }
      }

      // Establish real-time SSE listener
      function connectRealtimeListener() {
        if (sseConnection) {
          sseConnection.close();
          sseConnection = null;
        }

        const topic = getTopicName();
        try {
          sseConnection = new EventSource(`https://ntfy.sh/${topic}/sse`);

          sseConnection.onopen = () => {
            updateSyncStatus('synced');
          };

          sseConnection.onmessage = (event) => {
            try {
              const data = JSON.parse(event.data);
              if (data.event === 'message' && data.message) {
                const remote = JSON.parse(data.message);
                // Only process updates from other devices / browser tabs
                if (remote.senderId !== myClientId && remote.timestamp > lastSyncTimestamp) {
                  applyRemoteState(remote);
                  showToast('Live updated from paired device! ✨');
                }
              }
            } catch(err) {
              console.warn('Realtime message parse warning', err);
            }
          };

          sseConnection.onerror = () => {
            updateSyncStatus('syncing');
          };
        } catch(e) {
          console.warn('SSE connection init error', e);
        }
      }

