<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Daily Task Tracker & Planner</title>
  
  <!-- PWA & Mobile Web App Meta Tags -->
  <meta name="theme-color" content="#4f46e5" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="DayTrack Pro" />
  <link rel="apple-touch-icon" id="apple-touch-icon" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js for Weekly & Monthly Analytics -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            }
          }
        }
      }
    }
  </script>
  
  <style>
    body { 
      font-family: 'Inter', sans-serif; 
      -webkit-tap-highlight-color: transparent; 
      touch-action: manipulation;
    }
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(156, 163, 175, 0.3); border-radius: 9999px; }
    .task-completed {
      text-decoration: line-through;
      opacity: 0.6;
    }
    .pb-safe {
      padding-bottom: env(safe-area-inset-bottom, 1.25rem);
    }
    .pt-safe {
      padding-top: env(safe-area-inset-top, 0.5rem);
    }
    @media (max-width: 640px) {
      .bottom-sheet-drawer {
        border-bottom-left-radius: 0px !important;
        border-bottom-right-radius: 0px !important;
        max-height: 90vh;
      }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white">

  <!-- Desktop & Mobile Header Bar with Live Passcode Sync Badge -->
  <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200/90 pt-safe">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 sm:h-16 flex items-center justify-between">
      <div class="flex items-center gap-2.5 sm:gap-3">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white shadow-md shadow-indigo-100 flex-shrink-0">
          <i class="fa-solid fa-list-check text-sm sm:text-base"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="font-bold text-base sm:text-lg leading-tight tracking-tight text-slate-800">DayTrack Pro</h1>
            
            <!-- Passcode Sync Pill -->
            <button onclick="DayTracker.openPasscodeModal()" id="cloud-sync-status" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 transition hover:bg-emerald-100 shadow-2xs">
              <span id="cloud-pulse-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span id="passcode-display-badge" class="font-mono font-bold tracking-wider">SYNC: MY-PLANNER</span>
            </button>
          </div>
          <p class="text-[10px] sm:text-xs text-slate-500 font-medium hidden sm:block">Passcode-Secured Real-Time Cross-Device Planner</p>
        </div>
      </div>

      <!-- Header actions for Desktop / Tablet -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        <!-- Direct PWA Install Button (Displays when installable) -->
        <button id="btn-install-app" class="hidden items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-xs transition active:scale-95">
          <i class="fa-solid fa-download text-xs"></i>
          <span class="text-xs">Install App</span>
        </button>

        <button id="btn-open-templates" class="hidden md:flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-100 text-xs font-semibold transition active:scale-95">
          <i class="fa-solid fa-repeat text-indigo-600 text-xs"></i>
          <span>Habits Bank</span>
        </button>
        <button id="btn-end-day" class="flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-xs transition active:scale-95">
          <i class="fa-solid fa-award text-xs"></i>
          <span class="text-xs">End of Day</span>
        </button>
        <button onclick="DayTracker.openPasscodeModal()" class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-indigo-200 bg-indigo-50/70 hover:bg-indigo-100 text-xs text-indigo-700 font-bold transition" title="Change Passcode">
          <i class="fa-solid fa-key text-xs"></i>
          <span class="hidden md:inline">Sync Key</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-6xl mx-auto px-3 sm:px-6 py-3 sm:py-6 w-full flex-1 flex flex-col gap-4 sm:gap-6 pb-24 md:pb-8">
    
    <!-- Top Date Control Bar & Progress Metrics -->
    <div class="flex flex-col gap-3 bg-white p-3 sm:p-4 rounded-2xl border border-slate-200/90 shadow-xs">
      <div class="flex items-center justify-between gap-2 flex-wrap sm:flex-nowrap">
        <div class="flex items-center gap-1.5 sm:gap-2 flex-1 justify-between sm:justify-start">
          <button id="btn-prev-day" class="p-2.5 rounded-xl border border-slate-200 hover:bg-slate-100 text-slate-700 active:scale-95 transition" aria-label="Previous Day">
            <i class="fa-solid fa-chevron-left text-xs"></i>
          </button>
          
          <div class="flex items-center gap-2 bg-slate-50 px-3 py-2 rounded-xl border border-slate-200 flex-1 max-w-[220px] justify-center">
            <i class="fa-solid fa-calendar-day text-indigo-600 text-xs flex-shrink-0"></i>
            <input type="date" id="date-picker" class="bg-transparent font-bold text-slate-800 text-xs sm:text-sm focus:outline-none cursor-pointer w-full text-center">
          </div>
          
          <button id="btn-next-day" class="p-2.5 rounded-xl border border-slate-200 hover:bg-slate-100 text-slate-700 active:scale-95 transition" aria-label="Next Day">
            <i class="fa-solid fa-chevron-right text-xs"></i>
          </button>
        </div>
        
        <div class="flex items-center gap-1.5 w-full sm:w-auto justify-end">
          <button id="btn-today" class="flex-1 sm:flex-none px-3 py-2 text-xs font-bold rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200 active:scale-95 transition text-center">Today</button>
          <button id="btn-plan-tomorrow" class="flex-1 sm:flex-none px-3.5 py-2 text-xs font-bold rounded-xl bg-violet-600 text-white hover:bg-violet-700 active:scale-95 transition flex items-center justify-center gap-1.5 shadow-sm">
            <i class="fa-solid fa-wand-magic-sparkles text-xs"></i>
            <span>Plan Tomorrow</span>
          </button>
        </div>
      </div>

      <!-- Quick Metrics Bar -->
      <div class="grid grid-cols-3 gap-2 text-xs font-semibold text-slate-600 bg-slate-50/80 p-2.5 rounded-xl border border-slate-200">
        <div class="flex flex-col sm:flex-row items-center justify-center gap-1 text-center sm:text-left">
          <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Done</span>
          <span class="text-xs sm:text-sm font-extrabold text-slate-900"><span id="stat-achieved-count">0</span>/<span id="stat-total-count">0</span></span>
        </div>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-1 text-center sm:text-left border-x border-slate-200">
          <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Score</span>
          <span id="stat-rate" class="text-xs sm:text-sm font-extrabold text-indigo-600">0%</span>
        </div>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-1 text-center sm:text-left">
          <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Streak</span>
          <span id="stat-streak" class="text-xs sm:text-sm font-extrabold text-amber-500">0d</span>
        </div>
      </div>
    </div>

    <!-- Desktop Navigation Tabs (Schedule vs Analytics) -->
    <div class="hidden sm:flex border-b border-slate-200 text-sm font-semibold gap-6">
      <button id="tab-btn-planner" class="pb-3 text-indigo-600 border-b-2 border-indigo-600 flex items-center gap-2 transition">
        <i class="fa-solid fa-clock text-xs"></i> Time-Blocked Schedule
      </button>
      <button id="tab-btn-analytics" class="pb-3 text-slate-500 hover:text-slate-800 border-b-2 border-transparent flex items-center gap-2 transition">
        <i class="fa-solid fa-chart-column text-xs"></i> Weekly & Monthly Analytics
      </button>
    </div>

    <!-- VIEW 1: Daily Schedule View -->
    <div id="view-planner" class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6">
      <!-- Main Timeline Section -->
      <section class="lg:col-span-8 flex flex-col gap-3.5">
        <!-- Filter Tabs & Add Button -->
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-1 bg-white p-1 rounded-xl border border-slate-200 text-xs font-semibold shadow-2xs">
            <button data-filter="all" class="filter-btn px-3 py-1.5 rounded-lg bg-indigo-600 text-white font-bold transition">All</button>
            <button data-filter="pending" class="filter-btn px-2.5 py-1.5 rounded-lg text-slate-600 hover:bg-slate-100 transition">Pending</button>
            <button data-filter="completed" class="filter-btn px-2.5 py-1.5 rounded-lg text-slate-600 hover:bg-slate-100 transition">Achieved</button>
          </div>

          <button id="btn-desktop-add-task" class="hidden sm:flex px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs sm:text-sm font-bold shadow-md shadow-indigo-100 items-center gap-2 transition active:scale-95">
            <i class="fa-solid fa-plus text-xs"></i>
            <span>Add Time Slot</span>
          </button>
        </div>

        <!-- Dynamic Task List Container -->
        <div id="task-list" class="space-y-2.5 min-h-[280px]">
          <!-- Injected via JavaScript -->
        </div>

        <!-- Empty State Screen -->
        <div id="empty-state" class="hidden flex-col items-center justify-center p-8 sm:p-12 bg-white rounded-2xl border-2 border-dashed border-slate-200 text-center">
          <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-3">
            <i class="fa-solid fa-calendar-plus text-lg"></i>
          </div>
          <h3 class="font-bold text-slate-800 text-sm sm:text-base">No tasks scheduled for this day</h3>
          <p class="text-xs text-slate-500 max-w-xs mt-1 mb-4">Add your first time block or insert your recurring morning and evening habits with one tap.</p>
          <div class="flex gap-2">
            <button onclick="DayTracker.openTaskModal()" class="px-4 py-2.5 rounded-xl bg-indigo-600 text-white text-xs font-bold hover:bg-indigo-700 active:scale-95 transition">Add Slot</button>
            <button onclick="DayTracker.applyDefaultRecurring()" class="px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-xs font-bold hover:bg-slate-100 active:scale-95 transition">Load Habits</button>
          </div>
        </div>
      </section>

      <!-- Sidebar Controls / Habits -->
      <aside class="lg:col-span-4 flex flex-col gap-4">
        <!-- Daily Progress Bar -->
        <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-2xs flex flex-col gap-2.5">
          <div class="flex items-center justify-between">
            <h3 class="font-bold text-slate-800 text-xs sm:text-sm flex items-center gap-2">
              <i class="fa-solid fa-chart-pie text-indigo-600"></i> Daily Completion
            </h3>
            <span id="progress-percentage-label" class="text-xs font-black text-indigo-600">0%</span>
          </div>
          <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
            <div id="progress-bar-fill" class="bg-indigo-600 h-2 rounded-full transition-all duration-500 ease-out" style="width: 0%"></div>
          </div>
          <p id="progress-subtext" class="text-[11px] sm:text-xs text-slate-500 leading-normal">Schedule your time blocks to maintain peak focus.</p>
        </div>

        <!-- Quick Repeating Habits Bank -->
        <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-2xs flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <h3 class="font-bold text-slate-800 text-xs sm:text-sm flex items-center gap-1.5">
              <i class="fa-solid fa-repeat text-indigo-600"></i> Repeating Habits Bank
            </h3>
            <button id="btn-edit-recurring-list" class="text-xs text-indigo-600 font-bold hover:underline">Manage</button>
          </div>
          <p class="text-[11px] text-slate-500">Tap to instantly add to today's schedule:</p>
          <div id="quick-habits-container" class="flex flex-col gap-2">
            <!-- Dynamic quick habits -->
          </div>
        </div>
      </aside>
    </div>

    <!-- VIEW 2: Analytics & Achievement Charts View -->
    <div id="view-analytics" class="hidden flex-col gap-4 sm:gap-6">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 bg-white p-4 rounded-2xl border border-slate-200">
        <div>
          <h2 class="font-bold text-sm sm:text-base text-slate-800">Achievement Analytics</h2>
          <p class="text-xs text-slate-500">Review consistency trends, completion rates, and focus discipline.</p>
        </div>
        <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl text-xs font-bold w-full sm:w-auto">
          <button id="chart-toggle-week" class="flex-1 sm:flex-none px-3 py-1.5 rounded-lg bg-white text-indigo-700 shadow-xs">Weekly</button>
          <button id="chart-toggle-month" class="flex-1 sm:flex-none px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900">Monthly</button>
        </div>
      </div>

      <!-- KPI Summary Cards -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200">
          <span class="text-[10px] sm:text-xs text-slate-500 font-semibold uppercase">Avg Completion</span>
          <div class="text-lg sm:text-2xl font-black text-slate-800 mt-1" id="kpi-weekly-avg">0%</div>
          <span class="text-[10px] text-emerald-600 font-bold flex items-center gap-1 mt-0.5">
            <i class="fa-solid fa-arrow-trend-up text-[10px]"></i> Goal: &gt; 80%
          </span>
        </div>
        <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200">
          <span class="text-[10px] sm:text-xs text-slate-500 font-semibold uppercase">Current Streak</span>
          <div class="text-lg sm:text-2xl font-black text-amber-500 mt-1" id="kpi-streak">0 Days</div>
          <span class="text-[10px] text-slate-400 font-medium mt-0.5 block">Consistent days</span>
        </div>
        <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200">
          <span class="text-[10px] sm:text-xs text-slate-500 font-semibold uppercase">Total Achieved</span>
          <div class="text-lg sm:text-2xl font-black text-indigo-600 mt-1" id="kpi-total-achieved">0</div>
          <span class="text-[10px] text-slate-400 font-medium mt-0.5 block">Completed slots</span>
        </div>
        <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200">
          <span class="text-[10px] sm:text-xs text-slate-500 font-semibold uppercase">Focus Hours</span>
          <div class="text-lg sm:text-2xl font-black text-violet-600 mt-1" id="kpi-focus-hours">0h</div>
          <span class="text-[10px] text-slate-400 font-medium mt-0.5 block">Deep work logged</span>
        </div>
      </div>

      <!-- Main Achievement Graph -->
      <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-2xs">
        <div class="flex items-center justify-between mb-3">
          <h3 id="chart-main-title" class="font-bold text-xs sm:text-sm text-slate-800">Weekly Achievement Breakdown (%)</h3>
          <span class="text-[10px] text-slate-400">Passcode Synced</span>
        </div>
        <div class="w-full h-56 sm:h-72">
          <canvas id="achievementChart"></canvas>
        </div>
      </div>
    </div>
  </main>

  <!-- Mobile Floating Action Button (FAB) -->
  <button id="fab-add-task" class="sm:hidden fixed right-4 bottom-20 z-40 w-14 h-14 rounded-2xl bg-indigo-600 text-white shadow-xl shadow-indigo-300 flex items-center justify-center active:scale-90 transition-transform" aria-label="Add Time Slot">
    <i class="fa-solid fa-plus text-xl"></i>
  </button>

  <!-- Mobile Bottom Persistent Navigation Bar -->
  <nav class="sm:hidden fixed bottom-0 left-0 right-0 z-30 bg-white/95 backdrop-blur-lg border-t border-slate-200 pb-safe shadow-lg">
    <div class="grid grid-cols-4 h-14 items-center">
      <button id="nav-btn-tasks" class="flex flex-col items-center justify-center gap-1 text-indigo-600">
        <i class="fa-solid fa-calendar-day text-sm"></i>
        <span class="text-[10px] font-bold">Tasks</span>
      </button>
      <button id="nav-btn-analytics" class="flex flex-col items-center justify-center gap-1 text-slate-400 hover:text-slate-700">
        <i class="fa-solid fa-chart-column text-sm"></i>
        <span class="text-[10px] font-medium">Analytics</span>
      </button>
      <button id="nav-btn-habits" class="flex flex-col items-center justify-center gap-1 text-slate-400 hover:text-slate-700">
        <i class="fa-solid fa-repeat text-sm"></i>
        <span class="text-[10px] font-medium">Habits</span>
      </button>
      <button id="nav-btn-passcode" onclick="DayTracker.openPasscodeModal()" class="flex flex-col items-center justify-center gap-1 text-slate-400 hover:text-slate-700">
        <i class="fa-solid fa-key text-sm"></i>
        <span class="text-[10px] font-medium">Sync Key</span>
      </button>
    </div>
  </nav>

  <!-- ================= MODALS ================= -->

  <!-- 1. MODAL: Add / Edit Task -->
  <div id="modal-task" class="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs hidden flex items-end sm:items-center justify-center p-0 sm:p-4">
    <div class="bottom-sheet-drawer bg-white rounded-t-3xl sm:rounded-3xl w-full max-w-lg shadow-2xl border border-slate-100 overflow-hidden transform transition-all pb-safe">
      <div class="sm:hidden w-full flex justify-center pt-2.5 pb-1">
        <div class="w-10 h-1 rounded-full bg-slate-300"></div>
      </div>

      <div class="px-5 py-3.5 sm:px-6 sm:py-4 border-b border-slate-100 flex items-center justify-between">
        <h3 id="modal-task-title" class="font-bold text-slate-800 text-sm sm:text-base">Schedule New Time Slot</h3>
        <button id="btn-close-task-modal" class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 active:scale-95" aria-label="Close">
          <i class="fa-solid fa-xmark text-sm"></i>
        </button>
      </div>

      <form id="form-task" class="p-5 sm:p-6 space-y-3.5 max-h-[80vh] overflow-y-auto">
        <input type="hidden" id="task-id">
        <div>
          <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">Task Title</label>
          <input type="text" id="task-input-title" required placeholder="e.g. Deep Work: Review System Specs" class="w-full px-3.5 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
        </div>

        <div class="grid grid-cols-2 gap-2.5">
          <div>
            <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">Start Time</label>
            <input type="time" id="task-input-start" required class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-slate-900 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-slate-50">
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">End Time</label>
            <input type="time" id="task-input-end" required class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-slate-900 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-slate-50">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2.5">
          <div>
            <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">Priority</label>
            <select id="task-input-priority" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-slate-900 text-xs sm:text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-slate-50">
              <option value="High">🔴 High</option>
              <option value="Medium" selected>🟡 Medium</option>
              <option value="Low">🟢 Low</option>
            </select>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">Category</label>
            <select id="task-input-category" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-slate-900 text-xs sm:text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-slate-50">
              <option value="Deep Work">💼 Deep Work</option>
              <option value="Meeting">📞 Meeting</option>
              <option value="Health">🏃 Health</option>
              <option value="Personal">🌱 Personal</option>
              <option value="Planning">📝 Planning</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">Notes / Checklist (Optional)</label>
          <input type="text" id="task-input-notes" placeholder="e.g. Checklist or mobile reminder note" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-slate-900 text-xs sm:text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
        </div>

