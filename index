      function handleSaveTask(e) {
        e.preventDefault();
        const id = document.getElementById('task-id').value;
        const title = document.getElementById('task-input-title').value.trim();
        const start = document.getElementById('task-input-start').value;
        const end = document.getElementById('task-input-end').value;
        const priority = document.getElementById('task-input-priority').value;
        const category = document.getElementById('task-input-category').value;
        const notes = document.getElementById('task-input-notes').value.trim();
        const isRecurring = document.getElementById('task-input-recurring').checked;

        if (!title || !start || !end) return;

        if (!state.tasksByDate[currentDate]) {
          state.tasksByDate[currentDate] = [];
        }

        if (id) {
          const index = state.tasksByDate[currentDate].findIndex(t => t.id === id);
          if (index !== -1) {
            state.tasksByDate[currentDate][index] = {
              ...state.tasksByDate[currentDate][index],
              title, start, end, priority, category, notes, isRecurring
            };
          }
        } else {
          const newTask = {
            id: 'task_' + Date.now() + Math.random().toString(36).substring(2, 6),
            title, start, end, priority, category, notes,
            completed: false,
            isRecurring
          };
          state.tasksByDate[currentDate].push(newTask);

          if (isRecurring) {
            if (!state.habits.some(h => h.title.toLowerCase() === title.toLowerCase())) {
              state.habits.push({ id: 'h_' + Date.now(), title, start, end, priority, category });
              renderHabitsBank();
            }
          }
        }

        closeTaskModal();
        renderDayTasks();
        broadcastStateCloud();
        showToast('Saved & live synced!');
      }

