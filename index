      function updateDailyMetrics() {
        const dayTasks = state.tasksByDate[currentDate] || [];
        const total = dayTasks.length;
        const achieved = dayTasks.filter(t => t.completed).length;
        const rate = total === 0 ? 0 : Math.round((achieved / total) * 100);

        document.getElementById('stat-achieved-count').innerText = achieved;
        document.getElementById('stat-total-count').innerText = total;
        document.getElementById('stat-rate').innerText = `${rate}%`;
        document.getElementById('progress-percentage-label').innerText = `${rate}%`;
        document.getElementById('progress-bar-fill').style.width = `${rate}%`;

        const subtext = document.getElementById('progress-subtext');
        if (total === 0) {
          subtext.innerText = 'No tasks scheduled yet. Start scheduling your morning and afternoon blocks.';
        } else if (rate === 100) {
          subtext.innerText = '🎉 Outstanding! All scheduled slots completed!';
        } else {
          subtext.innerText = `${achieved} of ${total} slots achieved. Real-time synced to passcode.`;
        }

        const streak = calculateStreak();
        document.getElementById('stat-streak').innerText = `${streak}d`;
        document.getElementById('kpi-streak').innerText = `${streak} Days`;
      }

      function calculateStreak() {
        let streak = 0;
        let d = new Date();
        
        for (let i = 0; i < 365; i++) {
          const dateStr = getFormattedDate(d);
          const tasks = state.tasksByDate[dateStr] || [];
          const record = state.history[dateStr];
          
          const wasSuccessful = (record && record.rate >= 60) || (tasks.length > 0 && (tasks.filter(t => t.completed).length / tasks.length) >= 0.6);
          if (wasSuccessful) {
            streak++;
          } else {
            if (i === 0 && tasks.length === 0) {
              // Day in progress
            } else {
              break;
            }
          }
          d.setDate(d.getDate() - 1);
        }
        return streak;
      }

