        document.getElementById('btn-next-day').addEventListener('click', () => {
          const d = new Date(currentDate + 'T00:00:00');
          d.setDate(d.getDate() + 1);
          currentDate = getFormattedDate(d);
          datePicker.value = currentDate;
          renderDayTasks();
        });

        document.getElementById('btn-today').addEventListener('click', () => {
          currentDate = getFormattedDate(new Date());
          datePicker.value = currentDate;
          renderDayTasks();
        });

        document.getElementById('btn-plan-tomorrow').addEventListener('click', () => {
          const d = new Date();
          d.setDate(d.getDate() + 1);
          currentDate = getFormattedDate(d);
          datePicker.value = currentDate;
          renderDayTasks();
          showToast('Viewing tomorrow! Plan your day ahead.');
        });

        const tabPlanner = document.getElementById('tab-btn-planner');
        const tabAnalytics = document.getElementById('tab-btn-analytics');
        const viewPlanner = document.getElementById('view-planner');
        const viewAnalytics = document.getElementById('view-analytics');

        const switchToPlanner = () => {
          tabPlanner.className = 'pb-3 text-indigo-600 border-b-2 border-indigo-600 flex items-center gap-2 transition';
          tabAnalytics.className = 'pb-3 text-slate-500 hover:text-slate-800 border-b-2 border-transparent flex items-center gap-2 transition';
          viewPlanner.classList.remove('hidden');
          viewAnalytics.classList.add('hidden');
          document.getElementById('nav-btn-tasks').className = 'flex flex-col items-center justify-center gap-1 text-indigo-600';
          document.getElementById('nav-btn-analytics').className = 'flex flex-col items-center justify-center gap-1 text-slate-400 hover:text-slate-700';
        };

        const switchToAnalytics = () => {
          tabAnalytics.className = 'pb-3 text-indigo-600 border-b-2 border-indigo-600 flex items-center gap-2 transition';
          tabPlanner.className = 'pb-3 text-slate-500 hover:text-slate-800 border-b-2 border-transparent flex items-center gap-2 transition';
          viewPlanner.classList.add('hidden');
          viewAnalytics.classList.remove('hidden');
          document.getElementById('nav-btn-analytics').className = 'flex flex-col items-center justify-center gap-1 text-indigo-600';
          document.getElementById('nav-btn-tasks').className = 'flex flex-col items-center justify-center gap-1 text-slate-400 hover:text-slate-700';
          renderAnalytics();
        };

        tabPlanner.addEventListener('click', switchToPlanner);
        tabAnalytics.addEventListener('click', switchToAnalytics);

        document.getElementById('nav-btn-tasks').addEventListener('click', switchToPlanner);
        document.getElementById('nav-btn-analytics').addEventListener('click', switchToAnalytics);
        document.getElementById('nav-btn-habits').addEventListener('click', () => {
          renderHabitsBank();
          document.getElementById('modal-recurring').classList.remove('hidden');
        });

        document.querySelectorAll('.filter-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.filter-btn').forEach(b => {
              b.className = 'filter-btn px-2.5 py-1.5 rounded-lg text-slate-600 hover:bg-slate-100 transition';
            });
            btn.className = 'filter-btn px-3 py-1.5 rounded-lg bg-indigo-600 text-white font-bold transition';
            currentFilter = btn.dataset.filter;
            renderDayTasks();
          });
        });

        document.getElementById('fab-add-task').addEventListener('click', () => openTaskModal());
        document.getElementById('btn-desktop-add-task').addEventListener('click', () => openTaskModal());
        document.getElementById('btn-close-task-modal').addEventListener('click', closeTaskModal);
        document.getElementById('btn-cancel-task').addEventListener('click', closeTaskModal);
        document.getElementById('form-task').addEventListener('submit', handleSaveTask);

        document.getElementById('btn-end-day').addEventListener('click', openEndDayReview);
        document.getElementById('btn-close-review').addEventListener('click', () => document.getElementById('modal-review').classList.add('hidden'));
        document.getElementById('btn-cancel-review').addEventListener('click', () => document.getElementById('modal-review').classList.add('hidden'));
        document.getElementById('btn-finalize-review').addEventListener('click', finalizeReview);

        const modalHabits = document.getElementById('modal-recurring');
        const openHabitsHandler = () => {
          renderHabitsBank();
          modalHabits.classList.remove('hidden');
        };
        document.getElementById('btn-open-templates').addEventListener('click', openHabitsHandler);
        document.getElementById('btn-edit-recurring-list').addEventListener('click', openHabitsHandler);
        document.getElementById('btn-close-recurring').addEventListener('click', () => modalHabits.classList.add('hidden'));
        document.getElementById('btn-done-habits').addEventListener('click', () => modalHabits.classList.add('hidden'));

        document.getElementById('btn-add-habit').addEventListener('click', () => {
          const title = document.getElementById('input-new-habit-title').value.trim();
          const start = document.getElementById('input-new-habit-time').value;
          if (!title) return;
          state.habits.push({
            id: 'h_' + Date.now(),
            title,
            start: start || '08:00',
            end: '09:00',
            priority: 'Medium',
            category: 'Personal'
          });
          renderHabitsBank();
          broadcastStateCloud();
          document.getElementById('input-new-habit-title').value = '';
          showToast('Habit added to master bank!');
        });

        document.getElementById('btn-apply-all-habits').addEventListener('click', () => {
          applyDefaultRecurring();
          modalHabits.classList.add('hidden');
        });

        const btnWeek = document.getElementById('chart-toggle-week');
        const btnMonth = document.getElementById('chart-toggle-month');
        btnWeek.addEventListener('click', () => {
          chartRange = 'week';
          btnWeek.className = 'flex-1 sm:flex-none px-3 py-1.5 rounded-lg bg-white text-indigo-700 shadow-xs';
          btnMonth.className = 'flex-1 sm:flex-none px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900';
          renderAnalytics();
        });
        btnMonth.addEventListener('click', () => {
          chartRange = 'month';
          btnMonth.className = 'flex-1 sm:flex-none px-3 py-1.5 rounded-lg bg-white text-indigo-700 shadow-xs';
          btnWeek.className = 'flex-1 sm:flex-none px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900';
          renderAnalytics();
        });

        // Bind PWA Install triggers
        const btnInstallHeader = document.getElementById('btn-install-app');
        const btnInstallModal = document.getElementById('btn-modal-install-app');
        if (btnInstallHeader) btnInstallHeader.addEventListener('click', triggerPwaInstall);
        if (btnInstallModal) btnInstallModal.addEventListener('click', triggerPwaInstall);

        // Auto-reconnect on network return
        window.addEventListener('online', () => {
          pullLatestFromCloud(true);
          connectRealtimeListener();
        });

        // Initialize state
        loadLocalFallback();
        if (!state.tasksByDate[currentDate] || state.tasksByDate[currentDate].length === 0) {
          state.tasksByDate[currentDate] = defaultHabits.map(h => ({
            ...h,
            id: 'task_' + Date.now() + Math.random().toString(36).substring(2, 6),
            completed: false,
            notes: 'Master daily habit',
            isRecurring: true
          }));
          saveLocal();
        }

        renderDayTasks();
        renderHabitsBank();
        pullLatestFromCloud(true);
        connectRealtimeListener();
      }

      return {
        init,
        toggleTask,
        deleteTask,
        editTask: (id) => openTaskModal(id),
        openTaskModal: () => openTaskModal(),
        openPasscodeModal,
        closePasscodeModal,
        generateRandomPasscode,
        applyPasscode,
        copyPasscode,
        forcePushCloud,
        forcePullCloud,
        exportBackup,
        importBackup,
        deleteHabit,
        applyDefaultRecurring
      };
    })();

    window.DayTracker = DayTracker;

    window.addEventListener('DOMContentLoaded', () => {
      DayTracker.init();
    });
  </script>
</body>
</html>
