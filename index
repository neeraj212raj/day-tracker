      function finalizeReview() {
        const dayTasks = state.tasksByDate[currentDate] || [];
        const total = dayTasks.length;
        const achieved = dayTasks.filter(t => t.completed).length;
        const rate = total === 0 ? 0 : Math.round((achieved / total) * 100);

        state.history[currentDate] = {
          date: currentDate,
          total,
          achieved,
          rate,
          timestamp: Date.now()
        };

        const shouldCarryover = document.getElementById('check-carryover').checked;
        if (shouldCarryover) {
          const missed = dayTasks.filter(t => !t.completed);
          if (missed.length > 0) {
            const nextDateObj = new Date(currentDate + 'T00:00:00');
            nextDateObj.setDate(nextDateObj.getDate() + 1);
            const tomorrowStr = getFormattedDate(nextDateObj);

            if (!state.tasksByDate[tomorrowStr]) state.tasksByDate[tomorrowStr] = [];
            missed.forEach(m => {
              state.tasksByDate[tomorrowStr].push({
                ...m,
                id: 'task_' + Date.now() + Math.random().toString(36).substring(2, 6),
                notes: (m.notes ? m.notes + ' • ' : '') + 'Carried over from ' + currentDate,
