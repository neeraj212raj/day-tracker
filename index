      function renderAnalytics() {
        let totalAchievedCount = 0;
        let totalFocusMinutes = 0;

        Object.keys(state.tasksByDate).forEach(d => {
          (state.tasksByDate[d] || []).forEach(task => {
            if (task.completed) {
              totalAchievedCount++;
              if (task.start && task.end) {
                const [sh, sm] = task.start.split(':').map(Number);
                const [eh, em] = task.end.split(':').map(Number);
                const diff = (eh * 60 + em) - (sh * 60 + sm);
                if (diff > 0) totalFocusMinutes += diff;
              }
            }
          });
        });

        document.getElementById('kpi-total-achieved').innerText = totalAchievedCount;
        document.getElementById('kpi-focus-hours').innerText = `${Math.round(totalFocusMinutes / 60)}h`;

        const labels = [];
        const dataScores = [];
        const daysToInspect = chartRange === 'week' ? 7 : 30;

        const baseDate = new Date();
        for (let i = daysToInspect - 1; i >= 0; i--) {
          const d = new Date(baseDate);
          d.setDate(baseDate.getDate() - i);
          const dStr = getFormattedDate(d);
          
          if (chartRange === 'week') {
            labels.push(d.toLocaleDateString('en-US', { weekday: 'narrow', month: 'numeric', day: 'numeric' }));
          } else {
            labels.push(d.toLocaleDateString('en-US', { month: 'numeric', day: 'numeric' }));
          }

          if (state.history[dStr]) {
            dataScores.push(state.history[dStr].rate);
          } else if (state.tasksByDate[dStr] && state.tasksByDate[dStr].length > 0) {
            const count = state.tasksByDate[dStr].length;
            const done = state.tasksByDate[dStr].filter(t => t.completed).length;
            dataScores.push(Math.round((done / count) * 100));
          } else {
            dataScores.push(0);
          }
        }

        const nonZeroScores = dataScores.filter(s => s > 0);
        const avgScore = nonZeroScores.length ? Math.round(nonZeroScores.reduce((a,b)=>a+b,0) / nonZeroScores.length) : 0;
        document.getElementById('kpi-weekly-avg').innerText = `${avgScore}%`;

        const ctx = document.getElementById('achievementChart').getContext('2d');
        if (chartInstance) {
          chartInstance.destroy();
        }

        document.getElementById('chart-main-title').innerText = chartRange === 'week' 
          ? '7-Day Completion Rate (%)' 
          : '30-Day Completion Trend (%)';

        chartInstance = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [{
              label: 'Achievement %',
              data: dataScores,
              backgroundColor: dataScores.map(val => val >= 80 ? 'rgba(99, 102, 241, 0.9)' : 'rgba(165, 180, 252, 0.8)'),
              hoverBackgroundColor: '#4f46e5',
              borderRadius: 6,
              borderSkipped: false,
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: (context) => ` Achieved: ${context.parsed.y}%`
                }
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                max: 100,
                ticks: {
                  callback: (value) => value + '%',
                  font: { family: 'Inter', size: 10 }
                },
                grid: { color: 'rgba(226, 232, 240, 0.6)' }
              },
              x: {
                grid: { display: false },
                ticks: { font: { family: 'Inter', size: 9 }, maxRotation: 0 }
              }
            }
          }
        });
      }

      function exportBackup() {
        const payload = {
          version: '2.0',
          passcode: currentPasscode,
          exportedAt: new Date().toISOString(),
          tasksByDate: state.tasksByDate,
          habits: state.habits,
          history: state.history
        };
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `DayTrack_Backup_${currentDate}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        showToast('Backup file downloaded! 💾');
      }

      function importBackup(event) {
        const file = event.target.files && event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(e) {
          try {
            const data = JSON.parse(e.target.result);
            if (data && (data.tasksByDate || data.tasks)) {
              const incomingTasks = data.tasksByDate || data.tasks;
              state.tasksByDate = { ...state.tasksByDate, ...incomingTasks };
              if (data.habits && Array.isArray(data.habits)) {
                state.habits = data.habits;
              }
              if (data.history) {
                state.history = { ...state.history, ...data.history };
              }
              if (data.passcode) {
                currentPasscode = data.passcode.toUpperCase().replace(/[^A-Z0-9_-]/g, '-');
                localStorage.setItem('DAYTRACK_PASSCODE', currentPasscode);
              }
              saveLocal();
              renderDayTasks();
              renderHabitsBank();
              broadcastStateCloud(true);
              showToast('Backup restored successfully! ✨');
            } else {
              showToast('Invalid backup file format.');
            }
          } catch (err) {
            console.error('Import error:', err);
            showToast('Failed to parse backup file.');
          }
          event.target.value = ''; // Reset input
        };
        reader.readAsText(file);
      }

